# Dependency resolution
node-linker=hoisted

# Public hoisting patterns for React Native and Expo
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=@react-native/*
public-hoist-pattern[]=@expo/*

# Never build these packages - use prebuilt versions
never-built-dependencies=tiny-secp256k1,bigint-buffer

# Strict SSL for security
strict-ssl=true
