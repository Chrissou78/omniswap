{
  "version": 2,
  "buildCommand": "pnpm --filter @omniswap/web build",
  "installCommand": "pnpm install --frozen-lockfile",
  "builds": [
    {
      "src": "apps/web/package.json",
      "use": "@vercel/next@latest"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/web/$1"
    }
  ]
}
