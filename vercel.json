{
  "version": 2,
  "buildCommand": "pnpm --filter @omniswap/web build",
  "installCommand": "pnpm install --frozen-lockfile",
  "env": {
    "NEXT_PUBLIC_PAYMENT_WALLET_EVM": "@next_public_payment_wallet_evm",
    "NEXT_PUBLIC_PAYMENT_WALLET_SOLANA": "@next_public_payment_wallet_solana",
    "NEXT_PUBLIC_PAYMENT_WALLET_SUI": "@next_public_payment_wallet_sui"
  },
  "builds": [
    {
      "src": "apps/web/package.json",
      "use": "@vercel/next@latest"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/web/$1"
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD~1 HEAD -- apps/web/ packages/shared/ packages/types/ pnpm-lock.yaml"
}
